<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_asset_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.asset.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button in Button Box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_assigned_assets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-laptop"
                        groups="employee_asset_tracker.group_employee_asset_user">
                    <field name="asset_count" widget="statinfo" string="Assets Held"/>
                </button>
            </xpath>

            <!-- Dedicated Notebook Page for Offboarding / Audit -->
            <xpath expr="//notebook" position="inside">
                <page string="Assigned Assets" name="assigned_assets" groups="employee_asset_tracker.group_employee_asset_user">
                    <field name="assigned_asset_ids" readonly="1">
                        <list string="Assets Currently Held" decoration-info="state == 'draft'" decoration-success="state == 'available'" decoration-warning="state == 'assigned'">
                            <field name="asset_code"/>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="serial_number"/>
                            <field name="condition" widget="badge"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
