<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_asset_barcode" model="ir.actions.report">
        <field name="name">Asset Tag / Barcode Label</field>
        <field name="model">employee.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_asset_tracker.report_asset_barcode_template</field>
        <field name="report_file">employee_asset_tracker.report_asset_barcode_template</field>
        <field name="binding_model_id" ref="model_employee_asset"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Asset_Tag_%s' % (object.asset_code or object.name)</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_asset_barcode_template">
        <t t-call="web.basic_layout">
            <div class="page" style="font-family: Arial, sans-serif;">
                <t t-foreach="docs" t-as="o">
                    <div style="border: 2px dashed #4A5568; border-radius: 8px; padding: 16px; margin-bottom: 24px; max-width: 480px; page-break-inside: avoid;">
                        <!-- Header banner -->
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #CBD5E0; padding-bottom: 8px; margin-bottom: 12px;">
                            <div>
                                <strong style="font-size: 14px; text-transform: uppercase; color: #2B6CB0;" t-esc="o.company_id.name"/>
                                <div style="font-size: 10px; color: #718096;">Asset Management Property Tag</div>
                            </div>
                            <div style="text-align: right;">
                                <span class="badge" style="background-color: #ED8936; color: white; padding: 4px 8px; font-size: 10px; border-radius: 4px;" t-esc="o.category_id.name"/>
                            </div>
                        </div>

                        <!-- Asset details & QR side-by-side -->
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="flex-grow: 1; padding-right: 12px;">
                                <div style="font-size: 18px; font-weight: bold; color: #1A202C;" t-esc="o.name"/>
                                <div style="font-size: 15px; font-weight: bold; color: #2D3748; margin-top: 4px;">
                                    Tag: <span t-esc="o.asset_code"/>
                                </div>
                                <div t-if="o.serial_number" style="font-size: 11px; color: #4A5568; margin-top: 2px;">
                                    S/N: <span t-esc="o.serial_number"/>
                                </div>
                                <div t-if="o.location" style="font-size: 11px; color: #718096; margin-top: 2px;">
                                    Loc: <span t-esc="o.location"/>
                                </div>
                            </div>

                            <!-- QR Code -->
                            <div style="text-align: center;">
                                <img t-att-src="'/report/barcode/QR/%s?width=95&amp;height=95' % (o.barcode or o.asset_code)" alt="QR Code" style="width: 95px; height: 95px;"/>
                                <div style="font-size: 8px; color: #A0AEC0; margin-top: 2px;">SCAN TO VIEW</div>
                            </div>
                        </div>

                        <!-- 1D Barcode (Code128) -->
                        <div style="text-align: center; margin-top: 12px; padding-top: 8px; border-top: 1px solid #E2E8F0;">
                            <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=400&amp;height=65' % (o.barcode or o.asset_code)" style="max-width: 100%; height: 50px;" alt="Barcode"/>
                            <div style="font-family: monospace; font-size: 12px; letter-spacing: 2px; color: #2D3748; margin-top: 2px;" t-esc="o.barcode or o.asset_code"/>
                        </div>

                        <!-- Warning / Notice -->
                        <div style="font-size: 8px; text-align: center; color: #E53E3E; font-weight: bold; margin-top: 8px; text-transform: uppercase;">
                            Property of <span t-esc="o.company_id.name"/> — Unauthorized Removal or Tampering is Prohibited
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
